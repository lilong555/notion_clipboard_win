#include "@RESOURCE_HEADER_PATH_RC@"
#include <winver.h>

IDI_APP_ICON ICON "@APP_ICON_PATH_RC@"

1 VERSIONINFO
 FILEVERSION @NCW_VERSION_MAJOR@,@NCW_VERSION_MINOR@,@NCW_VERSION_PATCH@,@NCW_VERSION_BUILD@
 PRODUCTVERSION @NCW_VERSION_MAJOR@,@NCW_VERSION_MINOR@,@NCW_VERSION_PATCH@,@NCW_VERSION_BUILD@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "lilong\0"
            VALUE "FileDescription", "Notion Clipboard Win\0"
            VALUE "FileVersion", "@NCW_VERSION_STRING@\0"
            VALUE "InternalName", "notion_clipboard_win\0"
            VALUE "OriginalFilename", "notion_clipboard_win.exe\0"
            VALUE "ProductName", "Notion Clipboard Win\0"
            VALUE "ProductVersion", "@NCW_VERSION_STRING@\0"
            VALUE "LegalCopyright", "Copyright (c) lilong\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
